{
    "name": "clear-router",
    "version": "2.6.1",
    "description": "Laravel-style routing for Node.js with support for Express, H3, Fastify, Hono, and Koa, including CommonJS, ESM, and TypeScript support.",
    "keywords": [
        "h3",
        "srvx",
        "express",
        "routing",
        "laravel",
        "router",
        "middleware",
        "typescript",
        "esm",
        "node",
        "express-routing",
        "commonjs",
        "h3ravel"
    ],
    "homepage": "https://arkstack-hq.github.io/clear-router",
    "bugs": {
        "url": "https://github.com/toneflix/clear-router/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/toneflix/clear-router.git"
    },
    "license": "MIT",
    "author": "3m1n1nce <3m1n1nce@toneflix.net>",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./core": {
            "import": "./dist/core/index.mjs",
            "require": "./dist/core/index.cjs"
        },
        "./decorators": {
            "import": "./dist/decorators/index.mjs",
            "require": "./dist/decorators/index.cjs"
        },
        "./decorators/setup": {
            "import": "./dist/decorators/setup.mjs",
            "require": "./dist/decorators/setup.cjs"
        },
        "./express": {
            "import": "./dist/express/index.mjs",
            "require": "./dist/express/index.cjs"
        },
        "./fastify": {
            "import": "./dist/fastify/index.mjs",
            "require": "./dist/fastify/index.cjs"
        },
        "./h3": {
            "import": "./dist/h3/index.mjs",
            "require": "./dist/h3/index.cjs"
        },
        "./hono": {
            "import": "./dist/hono/index.mjs",
            "require": "./dist/hono/index.cjs"
        },
        "./koa": {
            "import": "./dist/koa/index.mjs",
            "require": "./dist/koa/index.cjs"
        },
        "./types/basic": "./dist/types/basic.mjs",
        "./types/express": "./dist/types/express.mjs",
        "./types/fastify": "./dist/types/fastify.mjs",
        "./types/h3": "./dist/types/h3.mjs",
        "./types/hono": "./dist/types/hono.mjs",
        "./types/koa": "./dist/types/koa.mjs",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "lint": "eslint",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "test:esm": "vitest tests/esm.test.ts",
        "test:ts": "vitest tests/typescript.test.ts",
        "test:coverage": "vitest run --coverage",
        "example": "tsx example/express/index.ts",
        "example:esm": "tsx example/express/esm.ts",
        "example:ts": "tsx example/express/typescript.ts",
        "build": "pnpm tsdown",
        "prepublishOnly": "pnpm build && pnpm vitest run --coverage && pnpm lint"
    },
    "peerDependencies": {
        "@koa/router": "^15.0.0",
        "express": "^5.1.0",
        "fastify": "^5.0.0",
        "h3": "^2.0.1-rc.16",
        "hono": "^4.0.0",
        "koa": "^3.0.0",
        "reflect-metadata": "^0.2.2"
    },
    "peerDependenciesMeta": {
        "@koa/router": {
            "optional": true
        },
        "express": {
            "optional": true
        },
        "fastify": {
            "optional": true
        },
        "h3": {
            "optional": true
        },
        "hono": {
            "optional": true
        },
        "koa": {
            "optional": true
        },
        "reflect-metadata": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^7.5.1",
        "@koa/router": "^15.5.0",
        "@types/express": "^4.17.21",
        "@types/koa": "^3.0.2",
        "@types/koa__router": "^12.0.5",
        "@types/node": "^20.10.6",
        "@vitest/coverage-v8": "4.1.5",
        "eslint": "^10.0.2",
        "fastify": "^5.8.2",
        "hono": "^4.12.8",
        "koa": "^3.2.0",
        "parasito": "^0.1.6",
        "reflect-metadata": "^0.2.2",
        "tsdown": "^0.20.3",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.56.1",
        "unrun": "0.2.27",
        "vite": "^8.0.11",
        "vitepress": "^2.0.0-alpha.17",
        "vitest": "^4.1.5"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
