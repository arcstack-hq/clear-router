{
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "lib": ["es2022", "DOM"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "types": ["node", "vitest", "express"],
    "paths": {
      "clear-router/core": ["src/core/index.ts"],
      "clear-router/core/*": ["src/core/*"],
      "clear-router/decorators": ["src/decorators/index.ts"],
      "clear-router/decorators/*": ["src/decorators/*"],
      "clear-router/express": ["src/express/index.ts"],
      "clear-router/express/*": ["src/express/*"],
      "clear-router/fastify": ["src/fastify/index.ts"],
      "clear-router/fastify/*": ["src/fastify/*"],
      "clear-router/h3": ["src/h3/index.ts"],
      "clear-router/h3/*": ["src/h3/*"],
      "clear-router/hono": ["src/hono/index.ts"],
      "clear-router/hono/*": ["src/hono/*"],
      "clear-router/koa": ["src/koa/index.ts"],
      "clear-router/koa/*": ["src/koa/*"]
    }
  },
  "include": [
    "src/**/*",
    "src/types/**/*",
    "tests/**/*",
    "example/**/*",
    "vitest.config.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
